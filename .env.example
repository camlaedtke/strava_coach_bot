# .env.example — Template for local development.
#
# Copy to .env and fill in real values. Never commit .env or .env.prod.
#
# DEPLOYMENT NOTE:
#   In Cloud Run (prod), environment variables are managed two different ways:
#
#   1. SECRETS (4 vars below) — stored in Google Cloud Secret Manager and
#      mounted at deploy time via --set-secrets in scripts/deploy.sh.
#      You do NOT set these in Cloud Run env var configuration; Secret Manager
#      injects them. Rotate via: gcloud secrets versions add SECRET_NAME ...
#
#   2. PLAIN ENV VARS (3 vars below) — set directly on the Cloud Run service
#      via --set-env-vars in scripts/deploy.sh. These are non-sensitive and
#      live in the deploy script itself.
#
#   Locally, all seven vars come from this file (copied to .env).


# ── Secrets (Cloud Secret Manager in deployed environments) ───────────────
# These are injected from Secret Manager in prod. Set real values here for
# local development only.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here


# ── Plain env vars (set directly in Cloud Run, not in Secret Manager) ─────
# SUPABASE_URL is a project endpoint URL, not a credential.
# STRAVA_CLIENT_ID is the public OAuth app identifier.
# STRAVA_REDIRECT_URI points to the OAuth callback; use your ngrok URL locally.

SUPABASE_URL=https://your-project-ref.supabase.co
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_REDIRECT_URI=https://your-ngrok-subdomain.ngrok.io/strava/callback
